# ===========================================================================
# .env.example — configuracion de la API
# ===========================================================================
#
# Copiar a `.env` y editar. `.env` esta en el .gitignore: este archivo es.
#
#   cp .env.example .env
#
# TODA la configuracion entra por aca. No hay ningun `os.getenv` suelto en el
# codigo de negocio: leerlo en el sitio equivocado es lo que obliga a tocar
# codigo cuando hay que cambiar algo.
#
# ===========================================================================
# QUE PASA CON OLLAMA CUANDO SE DESPLIEGA
# ===========================================================================
#
# `OLLAMA_BASE_URL` es lo UNICO que define donde vive el modelo. El codigo no
# cambia entre un escenario y otro:
#
#   DESARROLLO (esta maquina)
#     LLM_PROVIDER=ollama
#     OLLAMA_BASE_URL=http://host.docker.internal:11434
#     Apunta al Ollama que ya tenes instalado en el host.
#
#   PRODUCCION (nodo con GPU)
#     LLM_PROVIDER=ollama
#     OLLAMA_BASE_URL=http://ollama-gpu.interno:11434
#     Un servicio centralizado. La API se replica N veces y TODAS pegan al
#     mismo; el modelo se carga una sola vez en memoria.
#
#   PRODUCCION (API gestionada)
#     LLM_PROVIDER=openai
#     OPENAI_API_KEY=sk-...
#     OPENAI_BASE_URL=https://api.openai.com/v1
#
#     `OPENAI_BASE_URL` tambien acepta un gateway compatible (Azure OpenAI,
#     vLLM, LiteLLM). No es un cliente atado a OpenAI: es HTTP contra una API
#     que habla el mismo protocolo.
#
# Lo que hay que decidir antes de desplegar, y que el codigo NO decide:
#   - ¿Quien corre el modelo y quien paga su GPU?
#   - ¿Los datos del inventario pueden salir de la red interna?
#   - ¿Hay GPU, o el modelo va a CPU y hay que achicar el contexto?
#
# ===========================================================================


# --- General ---------------------------------------------------------------
APP_ENV=development
DEBUG=false

# --- Base de datos ---------------------------------------------------------
# En Docker el host es el nombre del servicio: `db`. Fuera de Docker, localhost.
DATABASE_URL=postgresql://postgres:secretpassword@db:5432/smart_inventory


# ===========================================================================
# PROVEEDOR DE IA
# ===========================================================================
# `ollama` u `openai`. Un valor distinto hace fallar el ARRANQUE de la API, no
# el primer request: un error en el deploy se ve antes de que llegue un usuario.
LLM_PROVIDER=ollama


# --- Ollama ----------------------------------------------------------------
# OJO con la URL: dentro de Docker, `localhost` es el PROPIO contenedor backend.
# Para alcanzar el Ollama del host hay que usar `host.docker.internal`.
OLLAMA_BASE_URL=http://host.docker.internal:11434

# El modelo principal. Un 8b anda bien en una Mac con 16 GB o mas.
OLLAMA_MODEL=llama3.1:8b

# Si el principal falla o contesta vacio, se reintenta con este. Es un 3b: cabe
# en cualquier lado y es la diferencia entre "responde lento" y "no responde"
# en una maquina sin GPU.
OLLAMA_FALLBACK_MODEL=llama3.2:3b

# Ventana de contexto. Es el mayor consumidor de RAM del host que corre el
# modelo: bajarlo a 4096 puede ser la diferencia entre que corra o no en una
# laptop chica.
OLLAMA_NUM_CTX=8192

# 0.1 es bajo a proposito. Para escribir SQL, una muestra creativa es un
# error, no un estilo.
OLLAMA_TEMPERATURE=0.1

# Segundos que se espera al modelo antes de cortar. Alto a proposito: un 8b en
# CPU puede tardar un minuto en la primera respuesta.
OLLAMA_TIMEOUT_SECONDS=120


# --- OpenAI (solo si LLM_PROVIDER=openai) ----------------------------------
# OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_TIMEOUT_SECONDS=60


# --- Tope de filas de las consultas que genera el modelo -------------------
# El modelo escribe el SQL; este es el unico limite que no puede saltarse.
AI_MAX_ROWS=500

# Segundos maximos de una consulta generada. Un modelo que responde
# "SELECT * FROM movement_history" sin filtro no debe tumbar la API.
AI_QUERY_TIMEOUT_SECONDS=10